# Turso (قاعدة بيانات سحابية دائمة) - اختياري
# عند ضبط هذه القيم يعمل الخادم بقاعدة Turso بدلاً من الملف المحلي wallet.db
TURSO_DATABASE_URL=libsql://<db>-<org>.turso.io
TURSO_AUTH_TOKEN=<token>

# أمان
# سر توقيع الجلسات - ضعه دائماً في الإنتاج
JWT_SECRET=<secret-random-طويل>
# كلمة مرور الأدمن عند أول إنشاء للحساب (اختياري، الافتراضي admin123)
ADMIN_PASSWORD=<كلمة مرور قوية>
