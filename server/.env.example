# Turso (قاعدة بيانات سحابية دائمة) - اختياري
# عند ضبط هذه القيم يعمل الخادم بقاعدة Turso بدلاً من الملف المحلي wallet.db
TURSO_DATABASE_URL=libsql://<db>-<org>.turso.io
TURSO_AUTH_TOKEN=<token>

# === مطلوب ===
# سر توقيع الجلسات - ضع قيمة عشوائية طويلة (32+ حرف)
JWT_SECRET=<secret-random-طويل>

# === مطلوب ===
# كلمة مرور الأدمن عند أول إنشاء للحساب (لا تُترك فاضية)
ADMIN_PASSWORD=<كلمة مرور قوية>

# === اختياري ===
# قائمة مصادر مسموح بها لـ CORS (مفصولة بفواصل)
# اتركها فاضية للسماح بالمصادر في وضع التطوير
ALLOWED_ORIGINS=https://your-app.onrender.com
